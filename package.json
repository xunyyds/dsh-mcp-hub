{
  "name": "@dsh-external/dsh-mcp-hub",
  "description": "MCP 多服务器统一控制台",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node lib/approval.test.mjs && node lib/approval.routes.test.mjs && node lib/approval.real.test.mjs && node lib/approval.e2e.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0",
    "react/jsx-runtime": "^18.2.0"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/approval.test.mjs",
    "lib/approval.routes.test.mjs",
    "lib/approval.real.test.mjs",
    "lib/approval.e2e.test.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ]
}
