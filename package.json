{
  "name": "@dsh-external/dsh-mcp-hub",
  "description": "MCP multi-server console for DSH — test, gate, budget, and back up every MCP server from one panel, with approvals that follow DSH.",
  "version": "1.6.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --check lib/index.js && node --check lib/client.js && node --check lib/gateway.js && node --check lib/context-budget.js && node --check lib/capability-index.js && node --check lib/jit-hint.js && node lib/gateway.regression.test.mjs && node lib/gateway.tiers.test.mjs && node lib/gateway.acceptance2.test.mjs && node lib/tiers.e2e.test.mjs && node lib/capability-index.test.mjs && node lib/jit-hint.test.mjs && node lib/retrieval.eval.test.mjs && node lib/integration.capabilities.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "approval",
    "streamable-http",
    "stdio"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xunyyds/dsh-mcp-hub.git"
  },
  "bugs": {
    "url": "https://github.com/xunyyds/dsh-mcp-hub/issues"
  },
  "homepage": "https://github.com/xunyyds/dsh-mcp-hub#readme",
  "author": "xunyyds",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0",
    "react/jsx-runtime": "^18.2.0"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/context-budget.js",
    "lib/capability-index.js",
    "lib/jit-hint.js",
    "lib/gateway.js",
    "lib/gateway.regression.test.mjs",
    "lib/gateway.tiers.test.mjs",
    "lib/gateway.acceptance2.test.mjs",
    "lib/tiers.e2e.test.mjs",
    "lib/capability-index.test.mjs",
    "lib/jit-hint.test.mjs",
    "lib/retrieval.corpus.mjs",
    "lib/retrieval.eval.test.mjs",
    "lib/integration.capabilities.test.mjs",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ]
}
