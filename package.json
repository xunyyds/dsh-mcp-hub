{
  "name": "@dsh-external/dsh-mcp-hub",
  "description": "MCP multi-server console for DSH — test, gate, budget, and back up every MCP server from one panel, with approvals that follow DSH.",
  "version": "1.4.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node lib/context-budget.test.mjs && node lib/gateway.test.mjs && node lib/gateway.routes.test.mjs && node lib/tool-catalog.test.mjs && node lib/registry-visibility.test.mjs && node lib/budget.e2e.test.mjs && node lib/budget.routes.test.mjs && node lib/patch-boundary.test.mjs && node lib/approval.test.mjs && node lib/approval.routes.test.mjs && node lib/approval.real.test.mjs && node lib/approval.e2e.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "approval",
    "streamable-http",
    "stdio"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xunyyds/dsh-mcp-hub.git"
  },
  "bugs": {
    "url": "https://github.com/xunyyds/dsh-mcp-hub/issues"
  },
  "homepage": "https://github.com/xunyyds/dsh-mcp-hub#readme",
  "author": "xunyyds",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0",
    "react/jsx-runtime": "^18.2.0"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/context-budget.js",
    "lib/gateway.js",
    "lib/context-budget.test.mjs",
    "lib/gateway.test.mjs",
    "lib/gateway.routes.test.mjs",
    "lib/tool-catalog.test.mjs",
    "lib/registry-visibility.test.mjs",
    "lib/budget.e2e.test.mjs",
    "lib/budget.routes.test.mjs",
    "lib/patch-boundary.test.mjs",
    "lib/approval.test.mjs",
    "lib/approval.routes.test.mjs",
    "lib/approval.real.test.mjs",
    "lib/approval.e2e.test.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ]
}
